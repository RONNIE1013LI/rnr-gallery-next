  "riskRules": [
    {
      "id": "green-routine",
      "risk": "GREEN",
      "triggers": ["canonical price", "location", "design feasibility", "normal product explanation", "simple acknowledgement"],
      "action": "May be eligible for automatic reply after all deterministic and channel gates pass."
    },
    {
      "id": "yellow-review",
      "risk": "YELLOW",
      "triggers": ["complex custom quote", "tight deadline", "unusual payment arrangement", "significant revision", "REVIEW fact", "incomplete context"],
      "action": "Create a human-review draft and do not auto-send."
    },
    {
      "id": "red-block",
      "risk": "RED",
      "triggers": ["refund", "chargeback", "legal threat", "serious complaint", "disputed payment", "special discount", "compensation", "unsupported claim"],
      "action": "Do not make a commitment; require human review and takeover."
    }
  ],
  "voice": {
    "style": [
      "Friendly but concise",
      "Natural English",
      "Practical and calm",
      "Answer the actual question first",
      "Use established conversation context",
      "Ask at most one necessary follow-up"
    ],
    "avoid": [
      "Long generic introductions",
      "Excessive enthusiasm",
      "Unsupported prices or delivery guarantees",
      "Repeated questions for known facts",
      "Pressure or unnecessary upselling"
    ],
    "responsePattern": "Direct answer, then one useful supporting detail, then one clear next step only when needed."
  },
