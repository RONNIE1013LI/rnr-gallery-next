{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/internal/customer-notifications",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/analytics/conversion-deliveries",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/analytics/conversion-retention",
      "schedule": "47 4 * * *"
    },
    {
      "path": "/api/internal/uploads/cleanup",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/internal/payment-proofs/cleanup",
      "schedule": "29 * * * *"
    },
    {
      "path": "/api/internal/reply-assistant/turn-recovery",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/internal/customer-chat/review-alerts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/internal/customer-chat/retention",
      "schedule": "13 4 * * *"
    }
  ]
}
